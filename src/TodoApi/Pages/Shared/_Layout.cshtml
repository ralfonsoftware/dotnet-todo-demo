<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>@ViewData["Title"] &middot; Todo</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>
        (function () {
            try {
                var stored = localStorage.getItem('todo-theme');
                var theme = stored === 'light' || stored === 'dark'
                    ? stored
                    : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
                document.documentElement.dataset.theme = theme;
            } catch (e) {
                document.documentElement.dataset.theme = 'light';
            }
        })();
    </script>
</head>
<body>
    <a class="skip-link" href="#main">Skip to content</a>

    <div class="wrap">
        <header class="topbar">
            <a class="brand" asp-page="/Index" aria-label="Todo home">
                <span class="brand-mark" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"
                         stroke-linecap="round" stroke-linejoin="round" focusable="false">
                        <path d="M5 12.5l4.2 4.2L19 7" />
                    </svg>
                </span>
                <span class="brand-text">
                    <span class="brand-name">todo</span>
                    <span class="brand-sub">personal</span>
                </span>
            </a>

            <div class="top-actions">
                <a class="docs-link" href="/scalar" target="_blank" rel="noreferrer"
                   aria-label="API reference (opens in a new tab)">
                    <span class="docs-text">API reference</span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"
                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                        <path d="M7 17L17 7M9 7h8v8" />
                    </svg>
                </a>

                <button class="icon-btn theme-toggle" type="button" data-theme-toggle
                        aria-label="Switch to dark theme">
                    <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
                         aria-hidden="true" focusable="false">
                        <path d="M20 13.2A8 8 0 1 1 10.8 4a6.4 6.4 0 0 0 9.2 9.2Z" />
                    </svg>
                    <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
                         aria-hidden="true" focusable="false">
                        <circle cx="12" cy="12" r="4" />
                        <path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4" />
                    </svg>
                </button>
            </div>
        </header>

        <main id="main">
            @RenderBody()
        </main>

        <footer class="footer">
            <p>In-memory demo &mdash; todos reset when the server restarts.</p>
            <p class="footer-hint"><kbd>N</kbd> to add a todo</p>
        </footer>
    </div>

    <script src="~/js/site.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
